# === 민감 정보 ===
.env
.env.*
*.key
*.pem
credentials.*
secrets.*

# === AI 도구 런타임 (동기화 불필요) ===
.omc/
.omo/
.sisyphus/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/history.jsonl
.claude/todos/
.claude/transcripts/

# === 프로젝트별 sync 복사본 (원본: _core/) ===
# scripts/sync-tools.cmd 실행으로 복원 가능 → GitHub에 중복 저장 불필요
projects/*/.claude/skills/
projects/*/.claude/agents/
projects/*/.claude/commands/
projects/*/.agent/skills/
projects/*/.agent/workflows/

# === 워크스페이스 루트 .claude (프로젝트 레벨 아닌 것) ===
.claude/

# === 에이전트 sync 복사본 (원본: _core/agents/v2/, scripts/sync-agents.py로 복원) ===
# Antigravity(.agent/) · Codex(.codex/) 미러 — git 중복 저장 불필요
.agent/
.codex/

# === 데스크탑 셋업 (OneDrive로 동기화되므로 git 불필요) ===
.desktop-setup/

# === 자체 git·원격을 가진 독립 프로젝트 (허브에서 추적 안 함) ===
# 나라장터 웹앱은 자체 저장소(github.com/eykissvrino/cnpncs)로 독립 관리
projects/P2026-004_나라장터모니터링_웹앱/

# === archive 내 레거시 프로젝트 (git submodule 충돌 방지) ===
archive/_archived_*/
archive/agents.md-main/
archive/antigravity/
archive/claude-code-harness/
archive/oh-my-openagent-dev/

# === 폰트 파일 ===
.fonts/

# === OS/에디터 ===
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# === 임시 파일 ===
*.tmp
*.bak
*.log
node_modules/
__pycache__/
.next/
.vercel/

# === 대용량 바이너리 (필요 시 개별 추가) ===
# *.pptx
# *.xlsx
# *.pdf
# *.docx

# === lock 파일 ===
.~lock.*
~$*
nul

